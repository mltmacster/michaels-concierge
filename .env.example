# Reference only. Set real values through approved local/managed configuration.
# This blank template is intentionally NOT runnable until configured.
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# App-only server-side signing override; never put in VITE_ variables.
MGECS_SESSION_SECRET=
# Comma-separated exact HTTPS app origins in production; no trailing slashes.
MGECS_APP_ORIGINS=
# Seconds; idle <= absolute. Defaults shown are policy, not credentials.
MGECS_SESSION_ABSOLUTE_SECONDS=3600
MGECS_SESSION_IDLE_SECONDS=900
